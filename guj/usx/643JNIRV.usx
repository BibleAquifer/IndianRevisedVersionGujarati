<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.1">
<book code="3JN" style="id">- Indian Revised Version - Gujarati -</book>
<para style="h">Book3JN</para>
<para style="toc1">Book3JN</para>
<para style="toc2">Book3JN</para>
<para style="mt1">Book3JN</para>
<chapter number="1" style="c" sid="3JN 1"/>
<para style="p"><verse number="1" style="v" sid="3JN 1:1"/>જેનાં પર હું સત્યમાં પ્રેમ રાખું છું, તે વહાલા ગાયસને લખનાર વડીલ.<verse eid="3JN 1:1"/></para>
<para style="p"><verse number="2" style="v" sid="3JN 1:2"/>મારા પ્રિય મિત્ર, હું પ્રાર્થના કરું છું કે જેમ તારો જીવ કુશળ છે તેમ તું સર્વ વાતમાં કુશળ તથા તંદુરસ્ત રહે.<verse eid="3JN 1:2"/></para>
<para style="p"><verse number="3" style="v" sid="3JN 1:3"/>કેમ કે ભાઈઓ આવ્યા ત્યારે તેઓએ તું સત્યમાં ચાલે છે તે પ્રમાણે તારા સત્ય વિષે સાક્ષી આપી, તેથી મને ઘણો આનંદ થયો.<verse eid="3JN 1:3"/></para>
<para style="p"><verse number="4" style="v" sid="3JN 1:4"/>મારાં બાળકો સત્યમાં ચાલે છે તેવું હું સાંભળું છું, તે કરતાં મને બીજો મોટો આનંદ નથી. ગાયસની પ્રશંસા<verse eid="3JN 1:4"/></para>
<para style="p"><verse number="5" style="v" sid="3JN 1:5"/>મારા પ્રિયો, જયારે ભાઈઓને માટે, હા, અજાણ્યા ભાઈઓને સારુ તું જે કંઈ કામ કરે છે; તે તો વિશ્વાસુપણે કરે છે.<verse eid="3JN 1:5"/></para>
<para style="p"><verse number="6" style="v" sid="3JN 1:6"/>તેઓએ તારા પ્રેમ વિષે મંડળી વિશ્વાસી સમુદાય આગળ સાક્ષી આપી છે. ઈશ્વર પ્રસન્ન થાય તેવી રીતે તું તેઓને આગળ પહોંચાડશે તો તું સારું કરશે.<verse eid="3JN 1:6"/></para>
<para style="p"><verse number="7" style="v" sid="3JN 1:7"/>કેમ કે તેઓ ઈસુના નામની ખાતર બહાર નીકળ્યા છે અને વિદેશીઓ પાસેથી કંઈ લેતા નથી.<verse eid="3JN 1:7"/></para>
<para style="p"><verse number="8" style="v" sid="3JN 1:8"/>આપણે તેવા માણસોનો સ્વીકાર કરવો જોઈએ કે જેથી આપણે સત્યનો પ્રચાર કરવામાં તેઓના સહકારીઓ થઈએ. દીયોત્રેફેસ અને દેમેત્રિયસ<verse eid="3JN 1:8"/></para>
<para style="p"><verse number="9" style="v" sid="3JN 1:9"/>મેં વિશ્વાસી સમુદાયને કંઈ લખ્યું, પણ દિયોત્રેફેસ, જે તેઓમાં મુખ્ય થવા ચાહે છે, તે અમારો સ્વીકાર કરતો નથી.<verse eid="3JN 1:9"/></para>
<para style="p"><verse number="10" style="v" sid="3JN 1:10"/>તે માટે જો હું આવીશ તો તે જે કામો કરે છે તે કામોને હું યાદ કરાવીશ; તે અમારી વિરુદ્ધ ખરાબ બોલીને બક્વાસ કરે છે, તેટલેથી સંતુષ્ટ ન થતાં પોતે ભાઈઓનો અંગીકાર કરતો નથી; તેમ જ જેઓ અંગીકાર કરવા ચાહે છે તેઓને તે અટકાવે છે અને મંડળીમાંથી તેઓને બહિષ્કૃત કરે છે.<verse eid="3JN 1:10"/></para>
<para style="p"><verse number="11" style="v" sid="3JN 1:11"/>મારા પ્રિય, દુષ્ટતાને નહિ, પણ સારાને અનુસરો. જે સારું કરે છે તે ઈશ્વરનો છે, જે ખરાબ કરે છે તેણે ઈશ્વરને જોયા નથી.<verse eid="3JN 1:11"/></para>
<para style="p"><verse number="12" style="v" sid="3JN 1:12"/>દેમેત્રિયસ વિષે સઘળાં સારું બોલે છે; અને તેઓ જે કહે છે તે સાથે સત્ય સંમત થાય છે અને અમે પણ તેના વિષે સારું કહીએ છીએ અને તું જાણે છે કે અમારી સાક્ષી ખરી છે. અંતિમ સલામી<verse eid="3JN 1:12"/></para>
<para style="p"><verse number="13" style="v" sid="3JN 1:13"/>મારે તારા પર ઘણું લખવાનું હતું, પણ શાહી તથા કલમથી હું તારા પર લખવા માગતો નથી,<verse eid="3JN 1:13"/></para>
<para style="p"><verse number="14" style="v" sid="3JN 1:14"/>પણ હું તને જલ્દી મળવાની આશા રાખું છું ત્યારે આપણે મુખોમુખ વાત કરીશું.<verse eid="3JN 1:14"/></para>
<para style="p"><verse number="15" style="v" sid="3JN 1:15"/>તને શાંતિ થાઓ. મિત્રો તને કુશળતા કહે છે. સર્વના નામ લઈને મિત્રોને ક્ષેમકુશળ કહેજે.<verse eid="3JN 1:15"/></para>
<chapter eid="3JN 1"/>
</usx>